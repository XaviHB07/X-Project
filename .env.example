# Copiar a `.env` (o exportar directamente en el entorno de despliegue) y
# ajustar según corresponda. El proyecto no carga automáticamente un archivo
# `.env` (no se agregó `python-dotenv`); exporta las variables en el proceso o
# configúralas en el gestor de secretos del despliegue.

# Cadena de conexión SQLAlchemy. Si no se define, se usa el valor de
# config/default.yaml (PostgreSQL local). DATABASE_URL permite configurar
# usuario, contraseña y servidor, sin guardar credenciales en el repo:
# DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/basededatos
DATABASE_URL=postgresql+psycopg://seleccion_app:CAMBIAR_PASSWORD@localhost:5432/seleccion_bayesiana

# Aprovisionamiento inicial del Administrador. Se usa solo si todavía no
# existe ninguna cuenta Administrador; los reinicios no cambian su contraseña.
# Configura ambas variables en el gestor de secretos del despliegue.
# La contraseña debe tener al menos 12 caracteres.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Nivel de logging estándar de Python.
LOG_LEVEL=INFO
