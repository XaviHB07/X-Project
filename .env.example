# Copiar a `.env` (o exportar directamente en el entorno de despliegue) y
# ajustar según corresponda. Ninguna de estas variables es leída
# automáticamente de un archivo `.env` por el proyecto (no se agregó
# `python-dotenv` para no sumar una dependencia más); son simplemente las
# variables de entorno que `src/services/bootstrap.py` sabe leer si están
# presentes en el proceso.

# Cadena de conexión SQLAlchemy. Si no se define, se usa el valor de
# config/default.yaml (SQLite local). En producción real, algo como:
# DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/basededatos
DATABASE_URL=sqlite:///./proyecto_grupo_X.db

# Nivel de logging estándar de Python.
LOG_LEVEL=INFO
